// Command logagg_lyth aggregates generated access-log lines (Lyth).
// It is used to compare binary size, build time, and memory with logagg_go.
import "lythbench/internal/fixtures"
import "lythbench/logagg/lythimpl"
import "os"

func main() throws {
    n := 200_000
    if len(os.Args) > 1 {
        n = os.Args[1].toInt()?
    }
    stats := lythimpl.Aggregate(fixtures.LogLines(n))?
    total: int64 = 0
    for s in stats {
        total += s.TotalMs
    }
    println(len(stats), total)
}
