// Package coll provides collection operations as extension functions on
// slices and maps: todos.Filter { it.Done }.Map { it.Title }. Each one
// allocates its result; a loop remains the cheapest choice on a hot path.
package coll

import "cmp"
import "slices"

// Filter returns the elements for which keep returns true.
func []T.Filter[T](keep: (T) -> bool): []T {
    out: []T = []
    for x in self {
        if keep(x) {
            out = append(out, x)
        }
    }
    return out
}

// Map returns the result of transform for each element, in order.
func []T.Map[T, R](transform: (T) -> R): []R {
    out := make([]R, 0, len(self))
    for x in self {
        out = append(out, transform(x))
    }
    return out
}

// FlatMap returns the results of transform for each element, concatenated.
func []T.FlatMap[T, R](transform: (T) -> []R): []R {
    out: []R = []
    for x in self {
        out = append(out, transform(x)...)
    }
    return out
}

// Find returns the first element for which match returns true, and whether
// there is one.
func []T.Find[T](match: (T) -> bool): (T, bool) {
    for x in self {
        if match(x) {
            return x, true
        }
    }
    zero: T
    return zero, false
}

// Any reports whether match returns true for some element.
func []T.Any[T](match: (T) -> bool): bool = slices.ContainsFunc(self, match)

// All reports whether match returns true for every element.
func []T.All[T](match: (T) -> bool): bool {
    for x in self {
        if !match(x) {
            return false
        }
    }
    return true
}

// Count returns the number of elements for which match returns true.
func []T.Count[T](match: (T) -> bool): int {
    n := 0
    for x in self {
        if match(x) {
            n++
        }
    }
    return n
}

// Fold combines the elements from first to last, starting with initial.
func []T.Fold[T, A](initial: A, combine: (A, T) -> A): A {
    acc := initial
    for x in self {
        acc = combine(acc, x)
    }
    return acc
}

// Partition returns the elements for which match returns true and the rest.
func []T.Partition[T](match: (T) -> bool): ([]T, []T) {
    yes: []T = []
    no: []T = []
    for x in self {
        if match(x) {
            yes = append(yes, x)
        } else {
            no = append(no, x)
        }
    }
    return yes, no
}

// Distinct returns the elements without repeats, in first-seen order.
func []T.Distinct[T: comparable](): []T {
    seen: map[T]bool = [:]
    out: []T = []
    for x in self {
        if x !in seen {
            seen[x] = true
            out = append(out, x)
        }
    }
    return out
}

// DistinctBy returns the first element for each key, in first-seen order.
func []T.DistinctBy[T, K: comparable](key: (T) -> K): []T {
    seen: map[K]bool = [:]
    out: []T = []
    for x in self {
        k := key(x)
        if k !in seen {
            seen[k] = true
            out = append(out, x)
        }
    }
    return out
}

// SortedBy returns a copy sorted by the key of each element; elements with
// equal keys keep their order. key runs once per element, in order: the keys
// are computed before sorting rather than at each comparison.
func []T.SortedBy[T, K: cmp.Ordered](key: (T) -> K): []T {
    pairs := make([]keyed[T, K], len(self))
    for i, x in self {
        pairs[i] = keyed[T, K](key = key(x), value = x)
    }
    slices.SortStableFunc(pairs, { a, b -> cmp.Compare(a.key, b.key) })
    out := make([]T, len(pairs))
    for i, p in pairs {
        out[i] = p.value
    }
    return out
}

// keyed is an element with its sort key.
struct keyed[T, K] {
    key: K
    value: T
}

// SortedWith returns a copy sorted by compare, which returns a negative
// number, zero, or a positive number as cmp.Compare does; elements that
// compare equal keep their order. It sorts by several keys or in descending
// order: { a, b -> cmp.Compare(b.Score, a.Score) }.
func []T.SortedWith[T](compare: (T, T) -> int): []T {
    out := copyOf(self)
    slices.SortStableFunc(out, compare)
    return out
}

// Take returns a copy of the first n elements, or of all of them when there
// are fewer; n <= 0 gives an empty slice.
func []T.Take[T](n: int): []T {
    out: []T = []
    if n <= 0 {
        return out
    }
    return append(out, self[:min(n, len(self))]...)
}

// ToSet returns a set of the elements: a map from each element to true, so
// x in set is a map lookup rather than a scan of the slice.
func []T.ToSet[T: comparable](): map[T]bool {
    out := make(map[T]bool, len(self))
    for x in self {
        out[x] = true
    }
    return out
}

// copyOf returns a copy of xs that is never nil, so an empty result encodes
// as [] rather than null.
func copyOf[T](xs: []T): []T {
    out := make([]T, len(xs))
    copy(out, xs)
    return out
}

// GroupBy groups the elements by their key, keeping their order within each
// group.
func []T.GroupBy[T, K: comparable](key: (T) -> K): map[K][]T {
    out: map[K][]T = [:]
    for x in self {
        k := key(x)
        out[k] = append(out[k], x)
    }
    return out
}

// AssociateBy maps the key of each element to the element; a later element
// replaces an earlier one with the same key.
func []T.AssociateBy[T, K: comparable](key: (T) -> K): map[K]T {
    out: map[K]T = [:]
    for x in self {
        out[key(x)] = x
    }
    return out
}

// Keys returns the keys of the map, in no particular order.
func map[K]V.Keys[K: comparable, V](): []K {
    out := make([]K, 0, len(self))
    for k in self {
        out = append(out, k)
    }
    return out
}

// SortedKeys returns the keys of the map in ascending order.
func map[K]V.SortedKeys[K: cmp.Ordered, V](): []K {
    keys := self.Keys()
    slices.Sort(keys)
    return keys
}

// Values returns the values of the map, in no particular order.
func map[K]V.Values[K: comparable, V](): []V {
    out := make([]V, 0, len(self))
    for _, v in self {
        out = append(out, v)
    }
    return out
}
