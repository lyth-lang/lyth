---
// The README's first example beside the Go `lyth gen` produces for it, rebuilt with the site.
import { Code } from '@astrojs/starlight/components';
import { go, source } from '../generated/home-example.json';

const lines = (code: string) => code.split('\n').filter((l) => l.trim()).length;
---

<div class="lyth-to-go not-content">
	<div class="side">
		<Code code={source} lang="lyth" title="users.lyth" />
	</div>
	<div class="side generated">
		<Code code={go} lang="go" title="users.lyth.go, generated" />
	</div>
</div>
<p class="lyth-to-go-note">
	The same program: {lines(source)} lines of Lyth, and the {lines(go)} lines of Go that <code>lyth gen</code> produces
	for it, generated by the current compiler each time the site is built. Every example in these docs has a Go
	tab made the same way.
</p>

<style>
	.lyth-to-go {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1rem;
		margin-top: 0;
	}
	/* the generated side is as tall as the Lyth side, and its code scrolls inside the frame */
	.generated {
		height: 0;
		min-height: 100%;
	}
	.generated :global(.expressive-code),
	.generated :global(.frame) {
		height: 100%;
	}
	.generated :global(.frame) {
		display: flex;
		flex-direction: column;
	}
	.generated :global(pre) {
		flex: 1;
		min-height: 0;
		overflow: auto;
	}
	.lyth-to-go-note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		max-width: 60ch;
	}
	@media (max-width: 50rem) {
		.lyth-to-go {
			grid-template-columns: minmax(0, 1fr);
		}
		.generated {
			height: 28rem;
			min-height: 0;
		}
	}
</style>
