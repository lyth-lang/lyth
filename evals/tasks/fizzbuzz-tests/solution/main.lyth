import "fmt"
import "strconv"
import "strings"

func fizzbuzz(n: int): string = when {
    n % 15 == 0 -> "FizzBuzz"
    n % 3 == 0 -> "Fizz"
    n % 5 == 0 -> "Buzz"
    else -> strconv.Itoa(n)
}

func main() {
    parts: []string = []
    for i in 1..15 {
        parts = append(parts, fizzbuzz(i))
    }
    fmt.Println(strings.Join(parts, " "))
}
