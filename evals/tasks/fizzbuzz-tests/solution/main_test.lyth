import "testing"

func check(t: *testing.T, n: int, want: string) {
    got := fizzbuzz(n)
    if got != want {
        t.Error("fizzbuzz(${n}) = ${got}, want ${want}")
    }
}

func TestPlain(t: *testing.T) {
    check(t, 1, "1")
    check(t, 7, "7")
}

func TestFizz(t: *testing.T) {
    check(t, 9, "Fizz")
}

func TestBuzz(t: *testing.T) {
    check(t, 10, "Buzz")
}

func TestFizzBuzz(t: *testing.T) {
    check(t, 30, "FizzBuzz")
}
