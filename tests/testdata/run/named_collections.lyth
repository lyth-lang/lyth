// Values of Go named collection types (http.Header, url.Values, sort.IntSlice)
// index, range, and take len like their underlying types; Go aliases
// (json.RawMessage) keep their names.

import "encoding/json"
import "fmt"
import "net/http"
import "net/url"
import "html/template"
import "sort"
import "lyth/coll"

func main() {
    h: http.Header = ["Accept": ["json"]]
    h["X-Id"] = ["7"]
    v, ok := h["X-Id"]
    fmt.Println(v, ok, len(h), "Accept" in h, "Nope" !in h)
    delete(h, "X-Id")
    keys: []string = []
    for k in h {
        keys = append(keys, k)
    }
    fmt.Println(keys)

    q := url.Values(["q": ["go"]])
    q["q"] = append(q["q"], "lyth")
    for k, vs in q {
        fmt.Println(k, vs, len(vs))
    }

    xs := sort.IntSlice([3, 1, 2])
    xs = append(xs, 0)
    sort.Sort(xs)
    fmt.Println(xs, xs[0], len(xs), xs[1:3], 2 in xs)
    for i, x in xs {
        fmt.Println(i, x)
    }
    first := xs[:2]
    fmt.Println(first.Len())

    raw := json.RawMessage(`{"a":1}`)
    fmt.Println(len(raw), string(raw[0:1]), raw[0] == '{')

    // lyth/coll extends them like their underlying slices and maps.
    names := sort.StringSlice(["b", "a", "c"])
    fmt.Println(names.Take(2), names.Filter { it != "a" }, q.SortedKeys())
    fmt.Println("b" in template.HTML("<b>"))
}

// Output:
// [7] true 2 true true
// [Accept]
// q [go lyth] 2
// [0 1 2 3] 0 4 [1 2] true
// 0 0
// 1 1
// 2 2
// 3 3
// 2
// 7 { true
// [b a] [b c] [q]
// true
