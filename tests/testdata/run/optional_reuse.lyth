// A smart-cast optional stored as an optional again reuses its box, `?:` with
// an optional on both sides is optional, and an if/when value with a null
// branch is optional.

struct Item {
    Name: string
    DiscountPct: int?
}

struct Point {
    X: int
    Y: int
}

func show(p: int?): int = p ?: -1

func clamp(pct: int?): int? {
    if pct != null {
        if pct > 100 {
            return 100
        }
        return pct
    }
    return null
}

func merge(out: Item, pct: int?): Item {
    o := out
    if pct != null {
        o.DiscountPct = pct
    }
    return o
}

func positions(pct: int?) {
    if pct != null {
        println(show(pct), show((pct)))
        it := Item(Name = "a", DiscountPct = pct)
        println(it.DiscountPct!!)
        xs: []int? = []
        xs = append(xs, pct)
        println(len(xs), xs[0]!!, pct in xs)
        m: map[string]int? = [:]
        m["k"] = pct
        println(m["k"]!!)
        y: int? = pct
        println(y!!)
        ys: []int? = [pct, null]
        println(ys[0]!!, ys[1] == null)
        f: () -> int? = { pct }
        println(f()!!)
    }
}

func either(a: int?, b: int?): int? = if a == null { b } else { a }

func firstSet(a: int?, b: int?): int? {
    if a != null {
        return a
    }
    return b
}

func pick(a: string?, b: string?): string? = a ?: b

func pickN(a: int?, b: int?): int? {
    return a ?: b
}

func size(s: string) {
    n := if s == "" { null } else { len(s) }
    println(n ?: -1)
}

func phone(raw: string): string? {
    p := if raw != "" { raw } else { null }
    return p
}

func origin(on: bool) {
    p := if on { Point(1, 2) } else { null }
    println(p?.X ?: 0)
}

func grade(n: int) {
    g := when {
        n < 0 -> null
        n < 50 -> "fail"
        else -> "pass"
    }
    println(g ?: "none")
}

func main() {
    println(clamp(150)!!, clamp(42)!!, clamp(null) == null)
    println(merge(Item(Name = "x"), 9).DiscountPct!!, merge(Item(Name = "x", DiscountPct = 1), null).DiscountPct!!)
    positions(7)
    positions(null)
    println(either(null, 2)!!, either(1, 2)!!, either(null, null) == null)
    println(firstSet(null, 2)!!, firstSet(1, 2)!!)

    a: string? = null
    b: string? = "b"
    x := a ?: b
    y: string? = a ?: b
    println(x!!, y!!, pick(a, b)!!, pick("a", b)!!, pick(null, null) == null)
    i: int? = null
    j: int? = 5
    k := i ?: j
    println(pickN(i, 2)!!, pickN(1, 2)!!, pickN(null, null) == null, k!!)

    size("")
    size("abc")
    println(phone("") == null, phone("555")!!)
    origin(true)
    origin(false)
    grade(-1)
    grade(10)
    grade(90)
    zs := [null, 1]
    println(len(zs), zs[0] == null, zs[1]!!)
}

// Output:
// 100 42 true
// 9 1
// 7 7
// 7
// 1 7 true
// 7
// 7
// 7 true
// 7
// 2 1 true
// 2 1
// b b b a true
// 2 1 true 5
// -1
// 3
// true 555
// 1
// 0
// none
// fail
// pass
// 2 true 1
