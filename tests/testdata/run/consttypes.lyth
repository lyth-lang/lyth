// A declared type wins over the default type of the constant that
// initializes it: g: float64 = 10 is a float64, in Go var g float64 = 10.
import "fmt"
import "time"

const N = 10
const F: float64 = 3
var Rate: float64 = 10

func main() {
    g: float64 = 10
    n: int = 2.0
    xs := [1, 2, 3]
    f: float64 = N
    h: float64 = F
    i := 5
    d: time.Duration = 2 * time.Second
    r: rune = 65
    b: byte = 'a'
    k: int64 = 1 << 3
    m: float64 = -N / 4
    fmt.Println(g / 4, xs[n], f / 4, h / 2, i, d, r, b, k, Rate / 4, m)
}

// Output:
// 2.5 3 2.5 1.5 5 2s 65 97 8 2.5 -2
