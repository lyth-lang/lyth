import "fmt"
import "io"
import "sort"

interface Shape {
    Area(): float64
}

// Value receivers: Circle and *Circle implement both interfaces.
struct Circle : Shape, fmt.Stringer {
    R: float64
}

func Circle.Area(): float64 = 3 * self.R * self.R
func Circle.String(): string = "circle(${self.R})"

// A pointer receiver: only *counter implements io.Writer.
struct counter : io.Writer {
    N: int
}

func *counter.Write(p: []byte): int throws {
    self.N += len(p)
    return len(p)
}

// Conformance to a Go interface with several methods.
struct byLen : sort.Interface {
    Words: []string
}

func byLen.Len(): int = len(self.Words)
func byLen.Less(i: int, j: int): bool = len(self.Words[i]) < len(self.Words[j])
func byLen.Swap(i: int, j: int) {
    a, b := self.Words[j], self.Words[i]
    self.Words[i] = a
    self.Words[j] = b
}

func main() throws {
    s: Shape = Circle(R = 2)
    println(s.Area(), Circle(R = 1))
    c := counter(N = 0)
    fmt.Fprintf(&c, "hello %d", 42)?
    println(c.N)
    words := ["banana", "fig", "kiwi"]
    sort.Sort(byLen(Words = words))
    println(words)
}

// Output:
// 12 circle(1)
// 8
// [fig kiwi banana]
