import "strings"

// break inside when exits the loop, as in Kotlin (Go needs a label).

func firstEven(xs: []int): int {
    i := 0
    while true {
        when {
            i >= len(xs) -> break
            xs[i] % 2 == 0 -> return xs[i]
        }
        i++
    }
    return -1
}

func sumUntil(xs: []int, stop: int): int {
    total := 0
    for x in xs {
        when x {
            stop -> break
            0 -> continue
            else -> total += x
        }
    }
    return total
}

func nested(): string {
    out := ""
    for i in 0..<3 {
        for j in 0..<3 {
            when j {
                2 -> break
                else -> out += "${i}${j} "
            }
        }
    }
    return out
}

func typeBreak(xs: []any): int {
    n := 0
    for x in xs {
        when x {
            is string -> break
            is int -> n += x
        }
    }
    return n
}

func main() {
    println(firstEven([1, 3, 4, 5]), firstEven([1, 3]))
    println(sumUntil([1, 0, 2, 9, 4], 9))
    println(strings.TrimSpace(nested()))
    println(typeBreak([1, 2, "stop", 3]))
}

// Output:
// 4 -1
// 3
// 00 01 10 11 20 21
// 3
