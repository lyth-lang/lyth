// typedlit: Go's typed literals []T{...}, [N]T{...}, [...]T{...}, map[K]V{...}
// beside Lyth's inferred [a, b] and [k: v].
import "encoding/json"

struct Point { X: int; Y: int }

func respond(v: any): string {
    b := json.Marshal(v) catch { return "?" }
    return string(b)
}

struct Page[T] {
    Items: []T
}

func Pairs[K: comparable, V](k: K, v: V): map[K][]V = map[K][]V{k: []V{v, v}}

func main() {
    ids := []int64{1, 2, 3}
    args := []any?{1, "a", true, null}
    status := map[string]any{"status": "ok", "count": 3}
    grid := [][]int{[1, 2], []int{3}}
    arr := [3]int{1, 2}
    sized := [...]string{"a", "b", "c"}
    pts := []Point{Point(1, 2), Point(X = 3, Y = 4)}
    nested := map[string][]Point{"a": [Point(5, 6)]}
    empty := []string{}
    emptyMap := map[string]int{}
    multi := map[string]int{
        "one": 1,
        "two": 2,
    }
    for x in ([]int{7, 8}) {
        println(x)
    }
    for k, v in map[string]int{"z": 26} {
        println(k, v)
    }
    if 2 in []int{1, 2} && len([2]string{"a"}) == 2 {
        println("in a header")
    }
    while len([]int{}) > 0 {
        break
    }
    println(ids, args, len(status), grid, arr, sized, len(sized), pts, nested)
    println(respond(empty), respond(emptyMap), respond(status), multi["two"], Pairs("k", 1.5))
    run { println("lambda still works") }
    inferred := [1, 2]
    typed := []int{1, 2}
    println(inferred == null, len(typed), Page[int](Items = []int{1}).Items)

    // Keys are compared at their Go type: in a map[any], 1 and 1.0 differ.
    keys := map[any]string{1: "int", 1.0: "float", "1": "string"}
    fs := []() -> int{{ 1 }, { 2 }}
    nulls := map[string]int?{"a": null, "b": 2}
    noneYet := [...]int{}
    text := "${len([]int{1, 2})} ${map[string]int{"a": 7}["a"]}"
    println(len(keys), fs[1](), nulls["a"] == null, len(noneYet), text)
}

func run(f: () -> unit) { f() }

// Output:
// 7
// 8
// z 26
// in a header
// [1 2 3] [1 a true <nil>] 2 [[1 2] [3]] [1 2 0] [a b c] 3 [{1 2} {3 4}] map[a:[{5 6}]]
// [] {} {"count":3,"status":"ok"} 2 map[k:[1.5 1.5]]
// lambda still works
// false 2 [1]
// 3 2 true 0 2 7
