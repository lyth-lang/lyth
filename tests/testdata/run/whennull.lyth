// A when over a nullable subject: a null branch smart-casts the subject in
// the branches after it, and in conditions never match null.
func size(s: string?): int = when s {
    null -> 0
    else -> len(s)
}

func kind(n: int?): string = when n {
    null -> "none"
    in 1..9 -> "small ${n}"
    else -> "big ${n + 0}"
}

func listed(s: string?): string {
    names := ["a": 1]
    return when s {
        in names -> "listed"
        else -> "not listed"
    }
}

func main() {
    println(listed("a"), listed("b"), listed(null))
    println(size(null), size("abc"), kind(null), kind(3), kind(20), other(null), other(4), other(40))
}

func other(n: int?): string = when n {
    !in 1..9 -> "out"
    else -> "in"
}

// Output:
// listed not listed not listed
// 0 3 none small 3 big 20 out in out
