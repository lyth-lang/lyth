// defer with catch evaluates the receiver, function value, and arguments at
// the defer, as Go does: a value method gets the copy made then, a pointer
// method sees later changes.
struct S {
    n: int
}

struct T {
    n: int
    cb: () -> error?
}

func T.Show(): error? {
    println("T show", n)
    return null
}

func pointers() {
    p := &T(1, { f1(9) })
    defer p.Show() catch {}
    defer p.cb() catch {}
    hs := [{ f2(8) }]
    defer hs[0]() catch {}
    hs[0] = { f2(0) }
    p.cb = { f1(0) }
    p.n = 2
}
func S.Show(): error? {
    println("show val", n)
    return null
}
func *S.Bump(): error? {
    println("bump ptr", n)
    return null
}
func f1(n: int): error? {
    println("f1", n)
    return null
}
func f2(n: int): error? {
    println("f2", n)
    return null
}
struct W {
    inner: T
}

// A value method's receiver is copied at the defer, also when it is a
// field, and a smart-cast optional is read as it was.
func copies() {
    w := W(T(1, { f1(0) }))
    defer w.inner.Show() catch {}
    w.inner.n = 2
    o: T? = T(3, { f1(0) })
    if o != null {
        defer o.Show() catch {}
    }
}

func main() {
    copies()
    pointers()
    s := S(1)
    defer s.Show() catch {}
    defer s.Bump() catch {}
    g := f1
    defer g(1) catch {}
    g = f2
    xs := [S(7)]
    defer xs[0].Show() catch {}
    xs[0] = S(8)
    s.n = 2
}

// Output:
// T show 3
// T show 1
// f2 8
// f1 9
// T show 1
// show val 7
// f1 1
// bump ptr 2
// show val 1
