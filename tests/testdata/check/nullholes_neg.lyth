// Ways a null could reach a non-null type, all rejected.
struct User {
    Name: string
}

struct Job {
    ID: int
    U: *User
}

interface Finder {
    Find(id: int): *User
}

interface Saver {
    Save(u: *User?)
}

struct Repo {
}

func Repo.Find(id: int): *User? = null

func Repo.Save(u: *User) {
    println(u.Name)
}

struct Cache : Finder { // ERROR E0212 "Cache does not implement Finder"
}

func Cache.Find(id: int): *User? = null

interface Shape {
    Area(): float64
}

struct Sq {
    S: float64
}

func Sq.Area(): float64 = self.S * self.S

func total[T: Shape](xs: []T): float64 {
    t := 0.0
    for x in xs {
        t += x.Area()
    }
    return t
}

func Eq[T: comparable](a: T, b: T): bool = a == b

sealed interface Kind {
    Label(): string
}

struct Red : Kind {
}

func Red.Label(): string = "red"

func label(k: Kind): string = when k {
    is Red -> k.Label()
}

func apply(u: *User?, f: (*User?) -> string): string = f(u)

func main() {
    f: Finder = Repo() // ERROR E0201 "method Find returns *User? where Finder promises *User"
    s: Saver = Repo() // ERROR E0201 "method Save takes *User where Saver passes *User?"
    println(apply(null, { u: *User -> u.Name })) // ERROR E0201 "parameter u cannot have type *User"
    shapes: []*Sq? = [null]
    println(total(shapes)) // ERROR E0213 "*Sq? cannot be the type T: it may be null"
    m: map[int?]string = [:] // ERROR E0213 "int? cannot be a map key: Go would compare the optional values by address"
    a: int? = null
    println(Eq(a, a)) // ERROR E0213 "int? cannot be the comparable type T"
    src: []*User? = [null]
    dst: []*User = [&User(Name = "a")]
    copy(dst, src) // ERROR E0201 "cannot copy []*User? into []*User"
    clear(dst) // ERROR E0405 "clear would set every element of []*User to its zero value"
    users := [3]*User{&User(Name = "x")} // ERROR E0405 "[3]*User needs all 3 elements"
    jobs: map[string]Job = [:]
    j: Job? = null
    ok := false
    j, ok = jobs["x"] // ERROR E0405 "Job has no zero value, so j, ok = "
    println(label(&Red())) // ERROR E0201 "*Red is not a member of sealed Kind; Red is"
    println(f, s, m, users, j, ok)
}
