struct Node {
    Value: int
    Next: *Node
}

func get(n: *Node?): int {
    return n.value // ERROR E0401 "it may be null"
}

func assign(s: string?) {
    p: *Node = null // ERROR E0402 "not nullable"
    q: *Node // ERROR E0405 "has no zero value"
    t: string = s // ERROR E0201 "expected string, found string?"
    v: string? = "a"
    if v != null {
        v = s
        println(len(v)) // ERROR E0401 "v is assigned after the check, which ends the smart cast"
    }
    v = null
    bad := Node(Value = 1) // ERROR E0211 "missing field Next"
    println(p, q, t, bad)
}

func list(): ([]int)? = null // ERROR E0406 "cannot be nullable"
func names(): []string? = [null, "a"]

func main() {
    println(get(null))
}
