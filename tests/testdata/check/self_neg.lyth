// self is a keyword: it cannot be declared, so nothing can shadow it.

struct Box {
    Size: int
}

func Box.area(self: int): int = Size // ERROR E0003 "self is the method receiver; it cannot be declared or redeclared"

func Box.twice(): int {
    self := 2 // ERROR E0003 "self is the method receiver"
    return self.Size * 2
}

func Box.each(xs: []int) {
    for self in xs { // ERROR E0003 "self is the method receiver"
        println(self)
    }
}

func *Box.bindings(xs: []int, ch: chan int) {
    g := { self: int -> 1 } // ERROR E0003 "self is the method receiver"
    h := { self -> 1 } // ERROR E0003 "self is the method receiver"
    when self := xs { // ERROR E0003 "self is the method receiver"
        else -> println(1)
    }
    select {
        self := ch.receive() -> println(1) // ERROR E0003 "self is the method receiver"
    }
    println(g, h)
}
