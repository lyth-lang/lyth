// Lyth before 0.1.0, which lyth fix rewrites.
import "cmp"
import "fmt"
import "strings"

val Greeting = "hi"

struct Box<T> {
    val Items: List<T>
}

fun Box<T>.First(): T = this.Items[0]

interface Named {
    fun Name(): String
}

struct Pet {
    PetName: String
}

fun Pet.Name(): String = PetName

fun <T: cmp.Ordered> maxOf(a: T, b: T): T = if a > b { a } else { b }

fun pick[T cmp.Ordered](a: T, b: T): T = maxOf<T>(a, b)

fun count(words: List<String>): Map<String, Int> {
    val counts: Map<String, Int> = [:]
    for (w in words) {
        counts[w] = counts[w] + 1
    }
    for (k, n in counts) {
        if n > 1 {
            fmt.Println("$k repeats")
        }
    }
    return counts
}

fun main() {
    val name = "lyth"
    var total: Int = 0
    var a = 1
    var b = 2
    (a, b) = (b, a)
    total = a * 10 + b
    val parts = strings.split("x,y,x", ",")
    val c = count(parts)
    fmt.Println("$name ${total} ${c["x"]} ${Greeting}")
    val box = Box<Int>(Items = [3, 4])
    fmt.Println(box.First(), maxOf(2, 5), pick(1.5, 0.5))
    val p: Named? = Pet{PetName: "rex"}
    if p != nil {
        fmt.Println(p.Name())
    }
    when (val n = total % 3) {
        0 -> fmt.Println("zero")
        else -> fmt.Println("rest ${n}")
    }
    val ch = make(Chan<Int>, 1)
    ch.send(7)
    select {
        val v = ch.receive() -> fmt.Println(v)
    }
}
