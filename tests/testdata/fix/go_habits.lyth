// Go spellings that lyth fix rewrites.
import (
    "cmp"
    "fmt"
    u "net/url"
    "strings"
)

struct Point {
    X: int
    Y: int
}

func Point.Sum(): int = X + Y

func biggest[T cmp.Ordered](xs: []T): T {
    best := xs[0]
    for x in xs {
        if x > best {
            best = x
        }
    }
    return best
}

func lookup(m: map[string]*Point, k: string): *Point? = m[k]

func main() {
    p := Point{X: 1, Y: 2}
    fmt.Println(p.Sum(), biggest([3, 9, 4]))
    if lookup(["a": &p], "b") == nil {
        fmt.Println("missing")
    }
    rows: for r in [[1, 2], [3]] {
        for v in r {
            if v == 2 {
                continue rows
            }
            fmt.Println(v)
        }
    }
    done := make(chan bool)
    go func() {
        done.send(true)
    }()
    done.receive()
    for i := 0; i < 2; i++ {
        fmt.Println(i)
    }
    for x in []int{1, 2} {
        fmt.Println(strings.repeat("*", x))
    }
    q := u.Values{"q": {"lyth"}, "page": {"2"}}
    fmt.Println(q.Encode())
    var b: strings.Builder
    b.writeString("done")
    fmt.Println(b.String())
}
