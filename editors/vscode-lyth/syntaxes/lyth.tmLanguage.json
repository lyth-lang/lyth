        {
          "match": "\\bmap\\b",
          "name": "keyword.map.lyth"
        },
        {
          "match": "\\bchan\\b",
          "name": "keyword.channel.lyth"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "match": "\\bbool\\b",
          "name": "storage.type.boolean.lyth"
        },
        {
          "match": "\\bbyte\\b",
          "name": "storage.type.byte.lyth"
        },
        {
          "match": "\\berror\\b",
          "name": "storage.type.error.lyth"
        },
        {
          "match": "\\b(?:complex(?:64|128)|float(?:32|64)|u?int(?:8|16|32|64)?)\\b",
          "name": "storage.type.numeric.lyth"
        },
        {
          "match": "\\brune\\b",
          "name": "storage.type.rune.lyth"
        },
        {
          "match": "\\bstring\\b",
          "name": "storage.type.string.lyth"
        },
        {
          "match": "\\buintptr\\b",
          "name": "storage.type.uintptr.lyth"
        },
        {
          "match": "\\bunit\\b",
          "name": "storage.type.unit.lyth"
        },
        {
          "match": "\\bany\\b",
          "name": "entity.name.type.any.lyth"
        },
        {
          "match": "\\bcomparable\\b",
          "name": "entity.name.type.comparable.lyth"
