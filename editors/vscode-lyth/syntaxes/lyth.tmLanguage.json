    "builtin-functions": {
      "match": "\\b(append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b(?=\\s*\\()",
      "name": "entity.name.function.support.builtin.lyth"
    },
    "function-calls": {
      "match": "\\b([A-Za-z_]\\w*)(?=\\s*(?:\\[[^\\]\\n]*\\]\\s*)?\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.lyth"
        }
      }
    },
    "variables": {
      "patterns": [
        {
          "match": "\\b[A-Za-z_]\\w*(?=\\s*(?:,\\s*[A-Za-z_]\\w*\\s*)*(?::=|(?:<<|>>|[-+*/%&|^])?=(?!=)))",
          "name": "variable.other.assignment.lyth"
        },
        {
          "match": "\\b[A-Za-z_]\\w*\\b",
          "name": "variable.other.lyth"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\?\\.|\\?:|!!|\\?",
          "name": "keyword.operator.optional.lyth"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.lyth"
        },
        {
          "match": "\\.\\.<|\\.\\.(?!\\.)",
          "name": "keyword.operator.range.lyth"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.ellipsis.lyth"
        },
        {
          "match": "&&|\\|\\||!(?!=)",
          "name": "keyword.operator.logical.lyth"
        },
        {
          "match": "==|!=|<=|>=|<(?![<=])|>(?![>=])",
          "name": "keyword.operator.comparison.lyth"
        },
        {
          "match": "\\+\\+",
          "name": "keyword.operator.increment.lyth"
        },
        {
          "match": "--",
          "name": "keyword.operator.decrement.lyth"
        },
        {
          "match": "(?:<<|>>|&\\^|[-+*/%&|^])?=|:=",
          "name": "keyword.operator.assignment.go"
        },
        {
          "match": "&(?=\\s*[A-Za-z_]\\w*)",
          "name": "keyword.operator.address.go"
        },
        {
          "match": "<<|>>|&\\^|[&|^]",
          "name": "keyword.operator.arithmetic.bitwise.lyth"
        },
        {
          "match": "[-+*/%]",
          "name": "keyword.operator.arithmetic.go"
        },
        {
          "match": "\\.",
          "name": "punctuation.other.period.lyth"
        },
        {
          "match": ",",
          "name": "punctuation.other.comma.lyth"
        },
        {
          "match": ":",
          "name": "punctuation.other.colon.lyth"
        }
      ]
    }
  }
}
