    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.lyth",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.lyth"
            }
          }
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.lyth",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lyth"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.lyth",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lyth"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lyth"
            }
