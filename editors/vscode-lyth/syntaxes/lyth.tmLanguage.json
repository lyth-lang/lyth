          "begin": "`",
          "end": "`",
          "name": "string.quoted.raw.lyth",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lyth"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lyth"
            }
          }
        },
        {
          "match": "'(?:[^'\\\\]|\\\\(?:[0-7]{3}|['\"\\\\abfnrtv]|x\\h{2}|u\\h{4}|U\\h{8}))'",
          "name": "string.quoted.rune.lyth"
        }
      ]
    },
    "escapes": {
      "match": "\\\\(?:[0-7]{3}|[\"'\\\\abfnrtv$]|x\\h{2}|u\\h{4}|U\\h{8})",
      "name": "constant.character.escape.lyth"
    },
    "template": {
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.lyth"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.lyth"
        }
      },
      "contentName": "meta.embedded.line.lyth",
      "patterns": [
        {
          "include": "#statements"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#statements"
        }
