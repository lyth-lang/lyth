              "name": "keyword.operator.optional.lyth"
            },
            {
              "match": "<-",
              "name": "keyword.operator.channel.lyth"
            }
          ]
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<!\\.)\\b(break|catch|continue|defer|else|for|go|if|in|is|as|return|select|throw|when|while)\\b",
          "name": "keyword.control.lyth"
        },
        {
          "match": "!(?:in|is)\\b",
          "name": "keyword.control.lyth"
        },
        {
          "match": "\\bfunc\\b",
          "name": "keyword.function.lyth"
        },
        {
          "match": "\\bvar\\b",
          "name": "keyword.var.lyth"
        },
        {
          "match": "\\bconst\\b",
          "name": "keyword.const.lyth"
        },
        {
          "match": "\\bimport\\b",
          "name": "keyword.control.import.lyth"
        },
        {
          "match": "\\b(package)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.package.lyth"
            },
            "2": {
              "name": "entity.name.type.package.lyth"
            }
          }
        },
        {
          "match": "\\b(throws|sealed)\\b",
          "name": "storage.modifier.lyth"
        }
      ]
    },
    "type-keywords": {
      "patterns": [
        {
          "match": "\\bstruct\\b",
          "name": "keyword.struct.lyth"
