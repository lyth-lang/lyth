              "match": "\\b[A-Za-z_]\\w*\\b",
              "name": "entity.name.type.lyth"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.address.go"
            },
            {
              "match": "\\?",
              "name": "keyword.operator.optional.lyth"
            },
            {
              "match": "<-",
              "name": "keyword.operator.channel.lyth"
            }
          ]
        },
        "3": {
          "name": "punctuation.other.period.lyth"
        },
        "4": {
          "name": "entity.name.function.lyth"
        },
        "5": {
          "patterns": [
            {
              "include": "#type-parameters"
            }
          ]
        }
      }
    },
    "type-declaration": {
      "match": "\\b(?:(sealed)\\s+)?(struct|interface|enum|type|typealias)\\s+([A-Za-z_]\\w*)(?:(\\[[^\\]\\n]*\\]))?(?:\\s*(:)\\s*((?:(?:\\*|\\[\\d*\\])*(?:map\\[[^\\]\\n]+\\])?(?:<-\\s*)?(?:chan\\b(?:\\s*<-)?\\s*)?(?:\\*|\\[\\d*\\])*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\[[^\\]\\n]*\\])?\\??)(?:\\s*,\\s*(?:\\*|\\[\\d*\\])*(?:map\\[[^\\]\\n]+\\])?(?:<-\\s*)?(?:chan\\b(?:\\s*<-)?\\s*)?(?:\\*|\\[\\d*\\])*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\[[^\\]\\n]*\\])?\\??)*))?",
      "captures": {
        "1": {
          "name": "storage.modifier.lyth"
        },
        "2": {
          "patterns": [
            {
              "include": "#type-keywords"
            }
          ]
        },
        "3": {
          "name": "entity.name.type.lyth"
        },
        "4": {
          "patterns": [
            {
              "include": "#type-parameters"
            }
          ]
        },
        "5": {
          "name": "punctuation.other.colon.lyth"
        },
        "6": {
          "patterns": [
            {
              "include": "#type-keywords"
            },
            {
              "include": "#storage-types"
            },
            {
              "match": "\\b[A-Za-z_]\\w*\\b",
              "name": "entity.name.type.lyth"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.address.go"
            },
            {
              "match": "\\?",
              "name": "keyword.operator.optional.lyth"
            },
            {
              "match": "<-",
              "name": "keyword.operator.channel.lyth"
            }
          ]
        }
      }
    },
    "type-parameters": {
      "patterns": [
        {
          "include": "#type-keywords"
        },
        {
          "include": "#storage-types"
        },
        {
          "match": "\\b[A-Za-z_]\\w*\\b",
          "name": "entity.name.type.lyth"
        },
        {
          "match": "\\*",
          "name": "keyword.operator.address.go"
        },
        {
          "match": "\\?",
          "name": "keyword.operator.optional.lyth"
        },
        {
          "match": "<-",
          "name": "keyword.operator.channel.lyth"
        },
        {
          "match": ":",
          "name": "punctuation.other.colon.lyth"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(break|continue)(@)([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.lyth"
            },
            "2": {
              "name": "punctuation.definition.label.lyth"
            },
            "3": {
              "name": "variable.other.label.lyth"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)(@)(?=\\s*(?:for|while)\\b)",
          "captures": {
            "1": {
              "name": "variable.other.label.lyth"
            },
            "2": {
              "name": "punctuation.definition.label.lyth"
            }
          }
        }
      ]
    },
    "typed-names": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(:)(?![:=])\\s*((?:\\*|\\[\\d*\\])*(?:map\\[[^\\]\\n]+\\])?(?:<-\\s*)?(?:chan\\b(?:\\s*<-)?\\s*)?(?:\\*|\\[\\d*\\])*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\[[^\\]\\n]*\\])?\\??)",
      "captures": {
        "1": {
          "name": "variable.parameter.lyth"
        },
        "2": {
          "name": "punctuation.other.colon.lyth"
        },
        "3": {
          "patterns": [
            {
              "include": "#type-keywords"
            },
            {
              "include": "#storage-types"
            },
            {
              "match": "\\b[A-Za-z_]\\w*\\b",
              "name": "entity.name.type.lyth"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.address.go"
            },
            {
              "match": "\\?",
              "name": "keyword.operator.optional.lyth"
            },
            {
              "match": "<-",
              "name": "keyword.operator.channel.lyth"
            }
          ]
        }
      }
    },
    "result-type": {
      "match": "(\\))\\s*(:)\\s*((?:\\*|\\[\\d*\\])*(?:map\\[[^\\]\\n]+\\])?(?:<-\\s*)?(?:chan\\b(?:\\s*<-)?\\s*)?(?:\\*|\\[\\d*\\])*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\[[^\\]\\n]*\\])?\\??)",
      "captures": {
        "2": {
          "name": "punctuation.other.colon.lyth"
        },
        "3": {
          "patterns": [
            {
              "include": "#type-keywords"
            },
            {
              "include": "#storage-types"
            },
            {
              "match": "\\b[A-Za-z_]\\w*\\b",
              "name": "entity.name.type.lyth"
            },
            {
              "match": "\\*",
              "name": "keyword.operator.address.go"
            },
            {
              "match": "\\?",
              "name": "keyword.operator.optional.lyth"
            },
            {
              "match": "<-",
              "name": "keyword.operator.channel.lyth"
            }
          ]
        }
      }
    },
    "type-tests": {
      "match": "(!?\\bis|\\bas\\??)\\s+((?:\\*|\\[\\d*\\])*(?:map\\[[^\\]\\n]+\\])?(?:<-\\s*)?(?:chan\\b(?:\\s*<-)?\\s*)?(?:\\*|\\[\\d*\\])*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\[[^\\]\\n]*\\])?\\??)",
      "captures": {
        "1": {
          "name": "keyword.control.lyth"
        },
