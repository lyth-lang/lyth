    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][\\h_]+\\b",
          "name": "constant.numeric.hexadecimal.lyth"
        },
        {
          "match": "\\b0[bB][01_]+\\b",
          "name": "constant.numeric.binary.lyth"
        },
        {
          "match": "\\b0[oO][0-7_]+\\b",
          "name": "constant.numeric.octal.lyth"
        },
        {
          "match": "\\b\\d[\\d_]*(?:\\.(?!\\.)\\d[\\d_]*)?(?:[eE][+-]?\\d+)?i\\b",
          "name": "constant.numeric.imaginary.lyth"
        },
        {
          "match": "\\b\\d[\\d_]*(?:\\.(?!\\.)\\d[\\d_]*)?(?:[eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.decimal.lyth"
        }
      ]
    },
    "func-declaration": {
      "match": "\\b(func)\\b\\s*(?:((?:\\*|\\[\\])*[A-Za-z_]\\w*(?:\\[[^\\]\\n]*\\])?)\\s*(\\.)\\s*)?([A-Za-z_]\\w*)?(\\[[^\\]\\n]*\\])?",
